TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=replace-with-a-turso-db-token
FLASK_SECRET_KEY=replace-with-a-random-secret-key
ADMIN_PASSWORD=replace-with-an-admin-password

# Percentage of total points a user must score to pass an exam (e.g. 80 = 80%).
PASSING_PERCENTAGE=80

# Gmail SMTP, used by scripts/grant_exam_access.py to email exam links.
# SMTP_USERNAME must be a full Gmail/Workspace address; SMTP_PASSWORD must be a
# 16-character Google Account "app password" (not your regular login password) —
# generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-your-gmail-address@gmail.com
SMTP_PASSWORD=replace-with-a-16-char-app-password
SMTP_FROM_NAME=Exam Team
